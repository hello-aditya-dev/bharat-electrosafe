# ─────────────────────────────────────────────────────────────────────────────
# Bharat Electrosafe — Environment Variables (PLACEHOLDERS ONLY)
#
# Copy this file to .env (local development) or set these variables
# in your Hostinger Node.js Web App environment variables panel.
#
# NEVER put real credentials in this file.
# NEVER commit .env to GitHub.
# ─────────────────────────────────────────────────────────────────────────────

# ── SMTP Email Configuration ──────────────────────────────────────────────────
# These configure the contact form's SMTP email delivery.

# Hostinger SMTP server hostname
SMTP_HOST=smtp.hostinger.com

# SMTP port — 587 for STARTTLS, 465 for SSL
SMTP_PORT=587

# Your business email account (the authenticated sender)
SMTP_USER=your-business-email@example.com

# Your email account password (ENTER THIS IN HOSTINGER ONLY — never in code)
SMTP_PASSWORD=your-email-password

# Set to "true" for port 465 (SSL), "false" for port 587 (STARTTLS)
SMTP_SECURE=false

# ── Mail Routing ─────────────────────────────────────────────────────────────

# Sender address shown in the From field (should match SMTP_USER for deliverability)
MAIL_FROM=your-business-email@example.com

# Recipient address where enquiries are delivered
MAIL_TO=your-receiving-email@example.com

# Optional CC recipient (leave empty if not needed)
MAIL_CC=

# ── Site / SEO ────────────────────────────────────────────────────────────────

# Set to "true" when you want search engines to index your production domain
ALLOW_INDEXING=false

# Your production domain URL (used for canonical URLs and sitemap)
NEXT_PUBLIC_SITE_URL=https://bharatelectrosafe.com

# ── Optional: Cloudflare Turnstile (bot protection) ───────────────────────────
# Only needed if Turnstile is enabled. Leave empty to disable.
TURNSTILE_SECRET_KEY=

# ── Optional: Upstash Redis (rate limiting) ──────────────────────────────────
# Only needed for distributed rate limiting. Leave empty for in-memory fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
